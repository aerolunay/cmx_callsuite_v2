# Server
SERVER_PORT=5060
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Session
SESSION_NAME=cmx_dialer_session
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE_HOURS=12

# MySQL (ViciDial's own "asterisk" schema)
MYSQL_HOST=dialer.cmxinnovations.com
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=asterisk
MYSQL_CONNECTION_LIMIT=10

# Asterisk Manager Interface (AMI) — dedicated cmxdialer manager user,
# see manager.conf entry in BUILD_SPEC.md. Not needed until the AMI phase.
AMI_HOST=dialer.cmxinnovations.com
AMI_PORT=5038
AMI_USER=cmxdialer
AMI_SECRET=
