# Server
SERVER_PORT=5060
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Session
SESSION_NAME=cmx_dialer_session
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE_HOURS=12

# MySQL (ViciDial's own "asterisk" schema)
MYSQL_HOST=dialer.cmxinnovations.com
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=asterisk
MYSQL_CONNECTION_LIMIT=10

# Asterisk Manager Interface (AMI) — dedicated cmxdialer manager user,
# see manager.conf entry in BUILD_SPEC.md. Not needed until the AMI phase.
AMI_HOST=dialer.cmxinnovations.com
AMI_PORT=5038
AMI_USER=cmxdialer
AMI_SECRET=

# Login rate limiting (authRoutes.js) — all optional, shown here with
# their defaults. The *_PER_IP ceilings are sized per-SITE (each office
# network gets its own independent counter), not per-agent — bump these
# if a single site's real headcount grows past what its default
# comfortably covers (current default of 300 covers a ~100-agent site
# with room for retries). The *_PER_EMAIL ceilings protect one account
# regardless of requester IP and don't need to scale with site size.
# RATE_LIMIT_WINDOW_MINUTES=15
# OTP_REQUEST_MAX_PER_IP=300
# OTP_REQUEST_MAX_PER_EMAIL=5
# OTP_LOGIN_MAX_PER_IP=300
# OTP_LOGIN_MAX_PER_EMAIL=10
# CHECK_USER_MAX_PER_IP=300
